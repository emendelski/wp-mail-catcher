{
  "name": "emendelski/wp-mail-catcher",
  "description": "WordPress plugin that records every wp_mail() message and shows it in wp-admin; blocks, redirects or passes mail through depending on the mode.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": ["wordpress", "wordpress-plugin", "wp_mail", "email", "development"],
  "homepage": "https://github.com/emendelski/wp-mail-catcher",
  "require": {
    "php": ">=8.0",
    "composer/installers": "^1.10 || ^2.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1 || ^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "extra": {
    "installer-name": "frontlabs-mail-catcher"
  },
  "autoload-dev": {
    "psr-4": {
      "FrontLabs\\MailCatcher\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
